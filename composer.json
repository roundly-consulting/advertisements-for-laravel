{
    "name": "roundly-consulting/advertisements-for-laravel",
    "description": "Manage advertisements, placements, and pricing for Laravel applications.",
    "keywords": [
        "roundly-consulting",
        "laravel",
        "advertisements"
    ],
    "homepage": "https://github.com/roundly-consulting/advertisements-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "illuminate/contracts": "^12.0|^13.0",
        "roundly-consulting/enums-for-laravel": "^1.0",
        "roundly-consulting/geolocation-for-laravel": "^1.0",
        "roundly-consulting/media-library-for-laravel": "^1.0",
        "roundly-consulting/money-for-laravel": "^1.0",
        "roundly-consulting/package-toolkit-for-laravel": "^1.0",
        "roundly-consulting/sluggable-for-laravel": "^1.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "roundly-consulting/testing-for-laravel": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\Advertisements\\": "src/",
            "RoundlyConsulting\\Advertisements\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\Advertisements\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=90"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\Advertisements\\AdvertisementsServiceProvider"
            ]
        }
    }
}
